<link rel="stylesheet" href="{{ 'redirection_popup.css' | asset_url }}">

<script>
  window.redirectionRules = {};
  window.marketCountries = {};
  
  {% if shop.metafields.countryblocker['redirection-rules'] %}
    try {
      window.redirectionRules = {{ shop.metafields.countryblocker['redirection-rules'] }};
    } catch (e) {
      console.error('Error parsing redirect rules:', e);
      window.redirectionRules = {};
    }
  {% endif %}
  
  {% if localization and localization.available_countries %}
    try {
      const availableCountries = {{ localization.available_countries | json }};
      availableCountries.forEach(country => {
        if (country.iso_code) {
          window.marketCountries[country.iso_code] = {
            country_code: country.iso_code,
            country_name: country.name,
            currency_code: country.currency.iso_code,
            currency_symbol: country.currency.symbol
          };
        }
      });
    } catch (e) {
      console.error('Error parsing localization countries:', e);
      window.marketCountries = {};
    }
  {% endif %}
</script>

<script src="{{ 'redirection_popup.js' | asset_url }}" defer></script>

<div id="redirection-popup" class="redirection-popup-overlay">
  <div class="redirection-popup-modal">
    <button class="redirection-popup-close" aria-label="Close popup">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    
    <div class="redirection-popup-content">
      <h2 class="redirection-popup-greeting">Select Your Country</h2>
      
      <div class="country-selector-wrapper">
        <div class="country-select-container">
          <input 
            type="text" 
            id="country-search" 
            class="country-search-input" 
            placeholder="Search or select country..."
          >
          <ul id="country-list" class="country-list"></ul>
        </div>
      </div>
      
      <button class="redirection-popup-button" id="confirm-country-btn" style="display: none;">
        Continue
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Redirection Popup",
  "target": "body"
}
{% endschema %}
